# Local competition files, selected passages, generated submissions and bundles.
/data/
/artifacts/
/submission*.csv
*.log
*.aux
*.out
*.synctex.gz
# Explicitly version small, text-free experiment tables despite the root *.csv rule.
!/final_results/*.csv
!/person_c_results/*.csv

# Audit result tables, excluding bulky per-row test diagnostics.
!/audit_results/*.csv
/audit_results/observable_features.csv
/audit_results/domain_scores.csv
!/neural_results/*.csv

!/last_refinement_results/*.csv
